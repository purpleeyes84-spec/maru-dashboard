<table><thead><tr><th>대비</th><th class="num">값</th></tr></thead><tbody>
<tr><td>완료주 평균 (금주 제외 ${C.완료주_수||0}주)</td><td class="num">${cell(C.완료주_평균)}</td></tr>
<tr><td>금주 일평균</td><td class="num">${cell(C.금주_일평균)}</td></tr>
<tr><td>금주 − 완료주평균</td><td class="num"><b>${vs}</b></td></tr>
</tbody></table>
<h3 style="margin:16px 0 8px;font-size:14px;color:var(--navy)">금주 진행 현황 <span class="chip">${G.기간약||""} · ${G.진행||""}</span></h3>
<table><thead><tr><th>요일</th><th>날짜</th><th>상태</th><th class="num">수량</th></tr></thead><tbody>${prog}</tbody></table>
<p class="sub" style="margin-top:8px">금주 일평균 <b>${cell(G.일평균)}</b> · 완료주평균 대비 <b>${vs}</b> · 규칙: ${W.rule||""}</p>`;

let mode="recent3w";
function recent3wSeries(){
  const set=new Set([...(W.앞선2주_dates||[]),...(W.이번주_dates||[])]);
  return (D.daily_product||[]).filter(x=>set.has(x.date));
}
function series(){
  if(mode==="month") return D.month_daily_product||[];
  if(mode==="recent3w") return recent3wSeries();
  return D.daily_product||[];
}
function renderChart(){
  const s=series();
  const chart=document.getElementById("chart"); chart.innerHTML="";
  if(!s.length){ document.getElementById("chartMeta").textContent="데이터 없음"; return; }
  const n=s.length;
  const vals=s.map(x=>+x.product_proxy||0);
  const vmax=Math.max(1,...vals);
  const padL=36, padR=12, padT=28, padB=36;
  const Wsvg=Math.max(520, n*48);
  const H=220;
  const iw=Wsvg-padL-padR, ih=H-padT-padB;
  const xAt=i=>padL+(n===1?iw/2:(i/(n-1))*iw);
  const yAt=v=>padT+ih-(v/vmax)*ih;
  const lineCls=mode==="month"?"line mo":(mode==="recent3w"?"line wk":"line");
  const dotBase=mode==="month"?"dot mo":(mode==="recent3w"?"dot wk":"dot");
  const w2=new Set(W.앞선2주_dates||[]);
  const tw=new Set(W.이번주_dates||[]);
  let pts="";
  vals.forEach((v,i)=>{ pts+=`${xAt(i).toFixed(1)},${yAt(v).toFixed(1)} `; });
  let grid="";
  for(let g=0;g<=4;g++){
    const yy=padT+(ih*g/4);
    const gv=Math.round(vmax*(1-g/4));
    grid+=`<line class="grid" x1="${padL}" y1="${yy}" x2="${Wsvg-padR}" y2="${yy}"/>`;
    grid+=`<text class="seg-note" x="4" y="${yy+3}">${gv}</text>`;
  }
  let dots="";
  s.forEach((x,i)=>{
    const v=+x.product_proxy||0;
    const cx=xAt(i), cy=yAt(v);
    let dc=dotBase;
    if(mode==="recent3w" && w2.has(x.date)) dc="dot w2";
    if(mode==="recent3w" && tw.has(x.date)) dc="dot wk";
    dots+=`<circle class="${dc}" cx="${cx}" cy="${cy}" r="4"><title>${x.date}: ${v}</title></circle>`;
    dots+=`<text class="vlab" x="${cx}" y="${cy-10}" text-anchor="middle">${fmt(v)}</text>`;
    dots+=`<text class="dlab" x="${cx}" y="${H-10}" text-anchor="middle">${x.label||dlab(x.date)}</text>`;
  });
  chart.innerHTML=`<svg viewBox="0 0 ${Wsvg} ${H}" width="${Wsvg}" height="${H}" role="img" aria-label="일별 애리후세 꺾은선">${grid}<polyline class="${lineCls}" points="${pts.trim()}"/>${dots}</svg>`;
  let meta=`${s[0].date} ~ ${s[s.length-1].date} · ${s.length}일 · 수량 볼드 · 꺾은선`;
  if(mode==="recent3w") meta+=` · 앞선2주(${(W.앞선2주_dates||[]).length}일)+이번주(${(W.이번주_dates||[]).length}일)`;
  document.getElementById("chartMeta").textContent=meta;
}
const tabs=document.getElementById("tabs");
[["recent3w","최근3주(월~토)"],["month","이번달"],["all","전체"]].forEach(([k,lab])=>{
  const b=document.createElement("button"); b.textContent=lab; b.className=k===mode?"on":"";
  b.onclick=()=>{mode=k;[...tabs.children].forEach(c=>c.classList.remove("on"));b.classList.add("on");renderChart();renderBots();renderProcs();};
  tabs.appendChild(b);
});
function renderBots(){
  const list=mode==="month"?(D.month_bottlenecks||[]):(D.bottlenecks||[]);
  document.getElementById("bots").innerHTML=`<table><thead><tr><th class="num">순위</th><th>공정</th><th class="num">하루평균</th><th class="num">기록일수</th></tr></thead><tbody>`+
    list.map(r=>`<tr><td class="num">${r.rank}</td><td>${r["공정"]}</td><td class="num">${fmt(r.mean)}</td><td class="num">${r.n}</td></tr>`).join("")+`</tbody></table>`;
}
function renderProcs(){
  const list=mode==="month"?(D.month_processes||[]):(D.processes||[]);
  const pmax=Math.max(1,...list.map(x=>x.mean||0));
  document.getElementById("procs").innerHTML=`<table><thead><tr><th>공정</th><th class="num">기록일수</th><th class="num">하루평균</th><th>분포</th></tr></thead><tbody>`+
    list.map(p=>`<tr><td>${p["공정"]}${p["공정"]==="애리후세"?" ★":""}</td><td class="num">${p.n}</td><td class="num">${fmt(p.mean)}</td>
      <td><div class="barwrap"><div class="bar"><i style="width:${(p.mean/pmax)*100}%"></i></div></div></td></tr>`).join("")+`</tbody></table>`;
}
renderChart(); renderBots(); renderProcs();
document.getElementById("foot").textContent=`애리후세 · 주간 월~토 · 갱신 ${D.updated||""}`;
</script></body></html>